{
  "compilerOptions": {
    "outDir": "../../dist/js",
    "rootDir": "./src",
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "resolveJsonModule": true,
    "strict": true,
    "declaration": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": [
    "./src/index.ts",
    "./src/dev-ssr.ts",
    "./src/ssr-worker.ts",
    "./src/fragments/renderer.ts",
    "./src/fragments/island.ts",
    "./src/astro.ts",
    "./src/sveltekit.ts",
    "./src/nuxt.ts",
    "./src/inertia-types.ts",
    "./src/virtual.d.ts"
  ]
}
