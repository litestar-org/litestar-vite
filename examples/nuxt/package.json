{
  "name": "nuxt",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "serve": "node .output/server/index.mjs",
    "watch": "npm run serve",
    "postinstall": "nuxt prepare",
    "typecheck": "vue-tsc -b --noEmit",
    "generate-types": "openapi-ts --config openapi-ts.config.ts"
  },
  "dependencies": {
    "nuxt": "4.6.4",
    "vue": "3.5.45",
    "zod": "4.6.7"
  },
  "overrides": {
    "@vitejs/devtools": "0.3.4"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.99.0",
    "@tailwindcss/vite": "4.3.5",
    "litestar-vite-plugin": "file:../..",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vue-tsc": "3.3.14"
  }
}
